{
  "compilerOptions": {
    "target": "ES2022",
    // ESLint and typecheck (this file) use Bundler resolution so vitest (an ESM-only package) resolves types.
    // The real build (output to dist) overrides this with CommonJS / Node resolution in tsconfig.build.json.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "newLine": "lf",
    "noEmit": true
  },
  "include": ["src", "test", "vitest.config.mts"]
}
