{
  // Extends tsconfig.json (the root tsconfig for ESLint and typecheck) and narrows
  // rootDir/outDir/include to src only for the real build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src"]
}
