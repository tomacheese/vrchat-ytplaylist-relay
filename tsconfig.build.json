{
  // tsconfig.json (ESLint / typecheck 用の Root tsconfig) を継承し、実ビルド用に
  // rootDir/outDir/include を src のみへ絞り込む。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src"]
}
