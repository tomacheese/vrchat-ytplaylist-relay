# HTTP server
PORT=8787

# Reverse proxy hops used to resolve X-Forwarded-For. Set this to the actual number of
# proxies in front of the server. Do not use an unconditionally trusting setting. Default: 1.
TRUST_PROXY=1

# Missing file disables the Playlist allowlist. Default: ./config/playlists.json
CONFIG_PATH=./config/playlists.json

# Persists Playlist position assignments and refresh status. Default: ./data
DATA_DIR=./data

# Bearer token for POST /admin/refresh and POST /admin/refresh/:playlistId.
# Leave empty to disable the HTTP admin endpoints. Default: unset
ADMIN_TOKEN=

# yt-dlp executable. The server passes --js-runtimes deno for YouTube extraction,
# so install Deno alongside yt-dlp for local runs. Default: yt-dlp (resolved from PATH)
YTDLP_PATH=yt-dlp

# Default maximum number of persistent positions per Playlist. The maxSlots value in
# the Playlist entry from CONFIG_PATH can override this. Default: 1000
DEFAULT_MAX_SLOTS=1000

# Timeout for one yt-dlp invocation, in milliseconds. Default: 60000
YTDLP_TIMEOUT_MS=60000

# How long a fetched manifest stays in the server's memory cache, in milliseconds.
# A new request refreshes it after this period. Default: 300000 (5 minutes)
MANIFEST_CACHE_TTL_MS=300000

# VOD delivery mode: redirect, relay, relay-redirect, proxy, or hybrid.
# hybrid is VOD-only. proxy and hybrid download and cache video data.
# Default: redirect
MEDIA_DELIVERY_MODE=redirect

# Live delivery mode: redirect, relay, relay-redirect, or proxy. hybrid is unsupported.
# If either mode is relay-redirect, set the other mode to redirect or relay-redirect.
# Default: redirect
LIVE_DELIVERY_MODE=redirect

# Shared output directory for Live proxy HLS files and VOD relay segments.
# Default: ./data/live
LIVE_RELAY_OUT_DIR=./data/live

# Idle lifetime for Live relays and VOD relay files, in milliseconds. Default: 300000 (5 minutes)
LIVE_RELAY_IDLE_TTL_MS=300000

# Maximum combined size of VOD relay segments in bytes. Live relay files are excluded.
# Least recently accessed VOD relay data is removed when the limit is exceeded.
# Default: 10737418240 (10 GiB)
LIVE_RELAY_MAX_BYTES=10737418240

# Maximum video height selected by yt-dlp in proxy and hybrid modes. Default: 1080
MEDIA_MAX_HEIGHT=1080

# Directory for downloaded VOD files and cache metadata in proxy and hybrid modes.
# Default: ./data/cache
MEDIA_CACHE_DIR=./data/cache

# Maximum total size of the downloaded VOD cache, in bytes. Least recently accessed files
# are evicted first when the limit is exceeded. Default: 10737418240 (10 GiB)
MEDIA_CACHE_MAX_BYTES=10737418240

# How long a downloaded VOD file stays fresh, in milliseconds. Default: 21600000 (6 hours)
MEDIA_CACHE_TTL_MS=21600000

# Timeout for one VOD download in proxy or hybrid mode, in milliseconds.
# Default: 600000 (10 minutes)
MEDIA_DOWNLOAD_TIMEOUT_MS=600000
