# HTTP port the server listens on.
PORT=8787

# Number of reverse proxy hops to trust for X-Forwarded-For header parsing (Express's
# "trust proxy" setting). Required to avoid express-rate-limit's ERR_ERL_UNEXPECTED_X_FORWARDED_FOR
# error when running behind a reverse proxy. Do not set this to an unconditionally-trusting value;
# match it to the actual number of proxy hops in front of this server. Default: 1 (single-hop
# reverse proxy).
TRUST_PROXY=1

# Path to the optional allowlist config file. If the file does not exist, the allowlist is
# disabled and any requested playlistId is served without pre-registration.
CONFIG_PATH=./config/playlists.json

# Directory where per-playlist slot allocation state (slots.json) is persisted.
# Playlist contents themselves (track order/titles) are NOT persisted here -
# they're fetched on demand from YouTube and cached in memory only (see MANIFEST_CACHE_TTL_MS).
DATA_DIR=./data

# Bearer token required for POST /admin/refresh and /admin/refresh/:playlistId.
# Leave unset to disable the admin HTTP endpoints entirely (refresh only via CLI).
# Normal operation never needs these; they only force-invalidate the in-memory manifest cache
# ahead of MANIFEST_CACHE_TTL_MS.
ADMIN_TOKEN=

# Path to the yt-dlp executable. Defaults to "yt-dlp" (resolved via PATH).
YTDLP_PATH=yt-dlp

# Default Position Pool size per playlist (can be overridden per playlist in the config file).
DEFAULT_MAX_SLOTS=1000

# Timeout for a single yt-dlp invocation, in milliseconds.
YTDLP_TIMEOUT_MS=60000

# How long (in milliseconds) a client-requested GET /:playlistId/manifest.json response is served
# from the in-memory cache before the next request triggers a fresh yt-dlp fetch.
MANIFEST_CACHE_TTL_MS=300000

# How GET /:playlistId/:position.mp4 serves VOD (non-Live) video. See LIVE_DELIVERY_MODE below
# for how Live video is handled separately.
# - redirect (default): 302 to https://www.youtube.com/watch?v=<videoId>. Simple, but playback
#   depends on VRChat's own bundled yt-dlp resolving the URL correctly, which is not always reliable.
# - relay: 302 to the HLS master manifest URL resolved by this server's own yt-dlp. Avoids the
#   redirect URL-resolution problem above without needing ffmpeg or disk cache (stateless).
# - proxy: this server downloads the video via its own yt-dlp (ffmpeg required to merge
#   video+audio DASH streams), caches it on disk, and serves the bytes directly with Range support.
#   Blocks the response until the download finishes, which can exceed the client's timeout.
# - hybrid: serves cached bytes directly (like proxy) when already cached; otherwise starts the
#   download in the background and immediately returns a redirect (like relay, falling back to
#   redirect only if the manifest cannot be resolved), so a client retry after its own timeout is
#   expected to hit the now-cached file.
MEDIA_DELIVERY_MODE=redirect

# How GET /:playlistId/:position.mp4 serves Live (currently-streaming) video, independently of
# MEDIA_DELIVERY_MODE. Same "redirect" / "relay" meanings as above; "hybrid" is not supported for
# Live and rejected at startup. Defaults to "redirect" (unset = current, non-Live behavior).
# - proxy: this server republishes the resolved HLS stream locally via ffmpeg (`-c copy`, no
#   re-encoding) and serves the local playlist/segment files, so any number of viewers share the
#   same single ffmpeg process. See LIVE_RELAY_OUT_DIR / LIVE_RELAY_IDLE_TTL_MS below.
LIVE_DELIVERY_MODE=redirect

# Directory where Live "proxy" mode writes republished HLS files (playlist + segments) while a
# stream is being relayed. Removed automatically when the relay stops.
LIVE_RELAY_OUT_DIR=./data/live

# How long (in milliseconds) a Live "proxy" republish process is kept running after its last
# viewer request before being stopped. Much shorter than MEDIA_CACHE_TTL_MS because the
# constraint here is the number of resident ffmpeg processes, not disk space. Default: 5 minutes.
LIVE_RELAY_IDLE_TTL_MS=300000

# Max height (px) to download in "proxy" mode. The highest-quality format at or below this is chosen.
MEDIA_MAX_HEIGHT=1080

# Directory where downloaded video files and their cache metadata are stored in "proxy" mode.
MEDIA_CACHE_DIR=./data/cache

# Total cache size cap (bytes) in "proxy" mode. Least-recently-accessed videos are evicted first
# once this is exceeded. Default: 10 GiB.
MEDIA_CACHE_MAX_BYTES=10737418240

# How long (in milliseconds) a downloaded video is considered fresh in "proxy" mode before the
# next request triggers a re-download. Default: 6 hours.
MEDIA_CACHE_TTL_MS=21600000

# Timeout for a single yt-dlp video download in "proxy" mode, in milliseconds. Higher than
# YTDLP_TIMEOUT_MS because downloading (and ffmpeg-merging) a full video takes much longer than
# listing a playlist. Default: 10 minutes.
MEDIA_DOWNLOAD_TIMEOUT_MS=600000
