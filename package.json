{
  "name": "vrchat-ytplaylist-relay",
  "version": "0.1.0",
  "description": "Backend that fetches YouTube playlists via yt-dlp and relays them as VRChat-consumable manifests (player-implementation agnostic).",
  "homepage": "https://github.com/tomacheese/vrchat-ytplaylist-relay",
  "bugs": {
    "url": "https://github.com/tomacheese/vrchat-ytplaylist-relay/issues"
  },
  "license": "MIT",
  "author": "Tomachi",
  "private": true,
  "type": "commonjs",
  "repository": {
    "url": "git@github.com:tomacheese/vrchat-ytplaylist-relay.git",
    "type": "git"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "refresh": "tsx src/cli.ts refresh",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:prettier": "prettier --check src test",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "lint:tsc": "tsc -p tsconfig.json --noEmit",
    "fix": "run-z fix:prettier,fix:eslint",
    "fix:prettier": "prettier --write src test",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "test": "vitest run",
    "test:integration": "cross-env RUN_INTEGRATION=1 vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.43",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "cross-env": "10.1.0",
    "eslint": "10.9.0",
    "only-allow": "^1.2.1",
    "prettier": "3.9.6",
    "run-z": "2.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "4.1.11"
  }
}
