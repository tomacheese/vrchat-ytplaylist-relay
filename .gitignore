# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov
.nyc_output

# TypeScript cache
*.tsbuildinfo

# Optional npm/eslint cache
.npm
.eslintcache

# dotenv environment variable files
.env
.env.*.local

# Dependencies / build output
node_modules/
dist/

# pnpm
.pnpm-store

# Application runtime data (yt-dlp/ffmpeg download cache, slot state, etc.)
data/*
!data/.gitkeep

# Playlist configuration actually served (per-user settings, so not tracked)
config/*.json
!config/*.json.example
