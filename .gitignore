# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov
.nyc_output

# TypeScript cache
*.tsbuildinfo

# Optional npm/eslint cache
.npm
.eslintcache

# dotenv environment variable files
.env
.env.*.local

# Dependencies / build output
node_modules/
dist/

# pnpm
.pnpm-store

# アプリケーション実行時データ (yt-dlp/ffmpeg のダウンロードキャッシュ・slot 状態など)
data/*
!data/.gitkeep

# 実際に配信対象とする Playlist 設定 (利用者ごとに異なる個人設定のため管理対象外)
config/*.json
!config/*.json.example
